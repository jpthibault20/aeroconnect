generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String   @id @unique @default(uuid())
  email                   String   @unique
  clubID                  String?
  firstName               String
  lastName                String
  phone                   String?
  restricted              Boolean  @default(false)
  role                    userRole @default(USER)
  country                 String?
  zipCode                 String?
  adress                  String?
  city                    String?
  clubIDRequest           String?
  classes                 Int[]    @default([])
  canSubscribeWithoutPlan Boolean  @default(false)
}

model flight_sessions {
  id                      String          @id @unique @default(uuid())
  clubID                  String
  sessionDateStart        DateTime        @db.Timestamptz(6)
  sessionDateDuration_min Int
  pilotID                 String
  pilotFirstName          String
  pilotLastName           String
  studentID               String?
  studentFirstName        String?
  studentLastName         String?
  student_type            flightType?
  finalReccurence         DateTime?       @db.Timestamptz(6)
  planeID                 String[]
  studentPlaneID          String?
  classes                 Int[]           @default([])
  studentEmail            String?
  studentPhone            String?
  pilotComment            String?
  studentComment          String?
  endLocation             String?
  hobbsEnd                Float?
  hobbsStart              Float?
  landings                Int?            @default(1)
  startLocation           String?
  flightType              NatureOfTheft?
  natureOfTheft           NatureOfTheft[] @default([])
  flightComment           String?
}

model planes {
  id                 String            @id @unique @default(uuid())
  clubID             String
  name               String
  immatriculation    String
  operational        Boolean           @default(true)
  classes            Int               @default(3)
  hobbsTotal         Float?            @default(0)
  // Physical owner of the plane. null => club plane. Set => private plane, visible
  // only to its owner, the club president (OWNER) and ADMIN.
  ownerID            String?
  // Club plane usages (instruction / rental / club use). Empty for a private plane:
  // "private" is carried by ownerID, not by a tag. INSTRUCTION/LOCATION/CLUB and
  // private are mutually exclusive.
  usageTypes         MachineUsage[]    @default([])
  // Maintenance intervention history, stored as JSON on the plane itself so the
  // plane <-> maintenance link can never break.
  // Shape: MaintenanceIntervention[] (see src/schemas/maintenance.ts).
  maintenanceHistory Json?
  // Plane photo: PATH inside the Supabase Storage bucket (never the full URL, so
  // the project/bucket is not baked into the DB). Shape: `{planeID}/{uuid}.{ext}`,
  // see src/lib/planeImage.ts. null => no photo.
  imagePath          String?
  // Instruction rate (cents / hour, instructor included) of a CLUB plane, debited
  // pro rata to the minutes when an instruction flight is signed. null => no rate
  // (not the same as 0): signing is then blocked if the club wallet is enabled.
  // Ignored for a private plane.
  instructionHourlyRateCents Int?
  MaintenanceTask    MaintenanceTask[]
  BaptemeOption      BaptemeOption[]
}

enum MachineUsage {
  INSTRUCTION
  LOCATION
  CLUB
}

model Club {
  id                          String   @id @unique
  Name                        String
  Address                     String?
  City                        String?
  Country                     String?
  ZipCode                     String?
  defaultAirfield             String?
  OwnerId                     String[]
  DaysOn                      String[]
  SessionDurationMin          Int      @default(60)
  AvailableMinutes            String[] @default([])
  HoursOn                     Int[]
  classes                     Int[]    @default([1, 2, 3, 4, 5, 6])
  preSubscribe                Boolean  @default(false)
  preUnsubscribe              Boolean  @default(false)
  timeDelaySubscribeminutes   Int      @default(0)
  timeDelayUnsubscribeminutes Int      @default(0)
  userCanSubscribe            Boolean  @default(true)
  userCanUnsubscribe          Boolean  @default(true)
  firstNameContact            String?
  lastNameContact             String?
  mailContact                 String?
  phoneContact                String?
  // Token of the public discovery-flight booking link
  // (/reservation/[clubID]/[token]). null => no active link. Regenerating the token
  // immediately invalidates the previous URL (ADMIN/OWNER only).
  publicBookingToken          String?
  // Student wallet (AER-66). Disabled by default: no debit, no booking block and no
  // wallet UI until the club enables it.
  walletEnabled               Boolean  @default(false)
  // Hourly rate (cents) charged for instruction flights on a PRIVATE plane: the
  // student only pays the instructor. null => not set.
  instructorHourlyRateCents   Int?
}

model MaintenanceTask {
  id                 String   @id
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  title              String
  intervalHours      Float?
  intervalMonths     Int?
  lastPerformedDate  DateTime
  lastPerformedHobbs Float
  planeId            String
  planes             planes   @relation(fields: [planeId], references: [id], onDelete: Cascade)
}

// Discovery-flight package offered on a CLUB plane: a duration and a price. A
// plane can have as many packages as the club wants (e.g. 15, 20, 30, 45 min).
// The calendar slot is always one hour regardless of the package; only what the
// customer sees (public page, flight comment, email) changes. Private planes are
// never offered to the public (see filterBaptemePlanes).
model BaptemeOption {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  durationMin Int
  price       Float
  planeId     String
  planes      planes   @relation(fields: [planeId], references: [id], onDelete: Cascade)

  @@index([planeId])
}

enum userRole {
  USER
  STUDENT
  PILOT
  OWNER
  ADMIN
  INSTRUCTOR
  MANAGER
}

enum flightType {
  FIRST_FLIGHT
  INITATION
  TRAINING
}

enum NatureOfTheft {
  TRAINING
  PRIVATE
  SIGHTSEEING
  DISCOVERY
  EXAM
}

enum BaptemeStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum pilotFunction {
  EP
  P
  I
}

enum flightNature {
  CDB
  INSTRUCTION
}

enum instructionSubType {
  LOCAL
  NAVIGATION
  LACHE
  BAPTEME
  EXAM
}

model flight_logs {
  id        String  @id @default(uuid())
  clubID    String
  sessionID String?

  date              DateTime @db.Date
  planeID           String?
  planeRegistration String
  planeName         String
  planeClass        Int?

  pilotID        String
  pilotFirstName String
  pilotLastName  String
  pilotFunction  pilotFunction

  instructorID        String?
  instructorFirstName String?
  instructorLastName  String?
  studentID           String?
  studentFirstName    String?
  studentLastName     String?
  studentEmail        String?
  studentPhone        String?

  flightNature       flightNature
  instructionSubType instructionSubType?
  takeoffs           Int                 @default(1)
  landings           Int                 @default(1)

  departureAirfield String?
  arrivalAirfield   String?

  hobbsStart       Float?
  hobbsEnd         Float?
  fuelAdded        Float?
  machineAnomalies String?

  pilotSigned         Boolean   @default(false)
  pilotSignedAt       DateTime? @db.Timestamptz(6)
  personalObservation String?

  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  isManualEntry Boolean  @default(false)
}

// Discovery-flight booking request made from the public link
// (/reservation/[clubID]/[token]) by an external customer without an account.
// A PENDING request places a hold on the slot (expiresAt = TTL) until the
// assigned pilot or management accepts/rejects it. Lazy expiry: a PENDING request
// whose expiresAt < now is treated as expired when read.
model BaptemeRequest {
  id                String        @id @default(uuid())
  clubID            String
  sessionID         String // targeted flight_sessions slot
  firstName         String
  lastName          String
  email             String
  phone             String
  comment           String?
  planeID           String // chosen club plane
  // Chosen package (duration + price), copied from BaptemeOption at request time so
  // it survives later changes to the plane's config (same idea as the denormalized
  // fields of flight_logs). null => the plane had no package configured.
  optionDurationMin Int?
  optionPrice       Float?
  status            BaptemeStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  expiresAt         DateTime // hold TTL
  handledBy         String? // userID of whoever accepted / rejected it
  handledAt         DateTime?

  @@index([clubID, status])
  @@index([sessionID, status])
}

enum WalletTransactionType {
  CREDIT // payment received (manual credit)
  DEBIT // automatic debit of a signed instruction flight
  ADJUSTMENT // manual withdrawal / correction, or automatic correction of an edited signed flight
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CARD
  OTHER
}

enum WalletRateSource {
  PLANE // club plane instruction rate
  INSTRUCTOR // club instructor rate (private plane)
}

// Current balance of a member IN a club (AER-66). Deliberately kept off `User`:
// many actions return full User rows to the client and the balance would leak.
// One row per (club, member), created on the first operation; no row => balance 0.
model Wallet {
  id           String   @id @default(uuid())
  clubID       String
  userID       String
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([clubID, userID])
}

// Immutable wallet ledger: never updated or deleted, mistakes are fixed with a
// reverse operation. Flight fields are denormalized (like flight_logs) so they
// stay readable if the plane or the rate changes later.
model WalletTransaction {
  id                String                @id @default(uuid())
  clubID            String
  userID            String
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  type              WalletTransactionType
  amountCents       Int // signed: > 0 credits, < 0 debits
  balanceAfterCents Int
  paymentMethod     PaymentMethod?
  comment           String?
  authorID          String? // null => automatic operation (flight signature / correction)
  flightLogID       String?
  flightDate        DateTime?             @db.Date
  planeName         String?
  planeRegistration String?
  durationMin       Int?
  rateCents         Int?
  rateSource        WalletRateSource?

  @@index([clubID, userID, createdAt])
  @@index([flightLogID])
}
