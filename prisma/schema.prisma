generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String   @id @unique @default(uuid())
  email                   String   @unique
  clubID                  String?
  firstName               String
  lastName                String
  phone                   String?
  restricted              Boolean  @default(false)
  role                    userRole @default(USER)
  country                 String?
  zipCode                 String?
  adress                  String?
  city                    String?
  clubIDRequest           String?
  classes                 Int[]    @default([])
  canSubscribeWithoutPlan Boolean  @default(false)
}

model flight_sessions {
  id                      String          @id @unique @default(uuid())
  clubID                  String
  sessionDateStart        DateTime        @db.Timestamptz(6)
  sessionDateDuration_min Int
  pilotID                 String
  pilotFirstName          String
  pilotLastName           String
  studentID               String?
  studentFirstName        String?
  studentLastName         String?
  student_type            flightType?
  finalReccurence         DateTime?       @db.Timestamptz(6)
  planeID                 String[]
  studentPlaneID          String?
  classes                 Int[]           @default([])
  studentEmail            String?
  studentPhone            String?
  pilotComment            String?
  studentComment          String?
  endLocation             String?
  hobbsEnd                Float?
  hobbsStart              Float?
  landings                Int?            @default(1)
  startLocation           String?
  flightType              NatureOfTheft?
  natureOfTheft           NatureOfTheft[] @default([])
  flightComment           String?
}

model planes {
  id                 String            @id @unique @default(uuid())
  clubID             String
  name               String
  immatriculation    String
  operational        Boolean           @default(true)
  classes            Int               @default(3)
  hobbsTotal         Float?            @default(0)
  // Propriétaire physique de la machine. null => machine du club (propriétaire =
  // le club). Renseigné => machine privée, visible seulement par le
  // propriétaire, le président (OWNER) et l'admin (ADMIN).
  ownerID            String?
  // Usages d'une machine du club (instruction / location / usage club). Vide
  // pour une machine privée : la nature « privée » est portée par ownerID, pas
  // par un tag. INSTRUCTION/LOCATION/CLUB et « privé » sont mutuellement exclusifs.
  usageTypes         MachineUsage[]    @default([])
  // Historique des interventions de maintenance, stocké en JSON directement sur
  // la machine pour garder un lien indestructible machine <-> maintenance.
  // Forme : MaintenanceIntervention[] (cf. src/schemas/maintenance.ts).
  maintenanceHistory Json?
  // Photo de la machine : CHEMIN dans le bucket Supabase Storage (jamais l'URL
  // complète, pour ne pas figer le projet/bucket en base). Forme :
  // `{planeID}/{uuid}.{ext}` — cf. src/lib/planeImage.ts. null => aucune photo.
  imagePath          String?
  // Tarif écolage (centimes / heure, instructeur compris) d'une machine DU
  // CLUB, débité au prorata des minutes à la signature d'un vol d'instruction.
  // null => pas de tarif (≠ 0 €) : la signature est alors bloquée si le
  // portefeuille du club est activé. Ignoré pour une machine privée.
  instructionHourlyRateCents Int?
  MaintenanceTask    MaintenanceTask[]
  BaptemeOption      BaptemeOption[]
}

enum MachineUsage {
  INSTRUCTION
  LOCATION
  CLUB
}

model Club {
  id                          String   @id @unique
  Name                        String
  Address                     String?
  City                        String?
  Country                     String?
  ZipCode                     String?
  defaultAirfield             String?
  OwnerId                     String[]
  DaysOn                      String[]
  SessionDurationMin          Int      @default(60)
  AvailableMinutes            String[] @default([])
  HoursOn                     Int[]
  classes                     Int[]    @default([1, 2, 3, 4, 5, 6])
  preSubscribe                Boolean  @default(false)
  preUnsubscribe              Boolean  @default(false)
  timeDelaySubscribeminutes   Int      @default(0)
  timeDelayUnsubscribeminutes Int      @default(0)
  userCanSubscribe            Boolean  @default(true)
  userCanUnsubscribe          Boolean  @default(true)
  firstNameContact            String?
  lastNameContact             String?
  mailContact                 String?
  phoneContact                String?
  // Jeton du lien public de réservation de baptêmes
  // (/reservation/[clubID]/[token]). null => aucun lien actif. Régénérer ce
  // jeton invalide immédiatement l'ancienne URL (cf. ADMIN/OWNER only).
  publicBookingToken          String?
  // Portefeuille élève (AER-66). Désactivé par défaut : aucun débit, aucun
  // blocage d'inscription, aucune UI portefeuille tant que le club ne l'active pas.
  walletEnabled               Boolean  @default(false)
  // Tarif horaire (centimes) appliqué aux vols d'instruction sur une machine
  // PRIVÉE : l'élève ne paie que l'instructeur. null => non renseigné.
  instructorHourlyRateCents   Int?
}

model MaintenanceTask {
  id                 String   @id
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  title              String
  intervalHours      Float?
  intervalMonths     Int?
  lastPerformedDate  DateTime
  lastPerformedHobbs Float
  planeId            String
  planes             planes   @relation(fields: [planeId], references: [id], onDelete: Cascade)
}

// Formule de vol baptême proposable sur une machine DU CLUB : une durée et un
// tarif. Une machine peut avoir autant de formules que le club veut (ex. 15,
// 20, 30, 45 min). Le créneau calendrier reste toujours d'une heure quelle que
// soit la formule choisie ; seule la partie visible côté client (page publique,
// commentaire du vol, mail) varie. Sans intérêt sur une machine privée : les
// machines privées ne sont jamais proposées au public (cf. filterBaptemePlanes).
model BaptemeOption {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  durationMin Int
  price       Float
  planeId     String
  planes      planes   @relation(fields: [planeId], references: [id], onDelete: Cascade)

  @@index([planeId])
}

enum userRole {
  USER
  STUDENT
  PILOT
  OWNER
  ADMIN
  INSTRUCTOR
  MANAGER
}

enum flightType {
  FIRST_FLIGHT
  INITATION
  TRAINING
}

enum NatureOfTheft {
  TRAINING
  PRIVATE
  SIGHTSEEING
  DISCOVERY
  EXAM
}

enum BaptemeStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum pilotFunction {
  EP
  P
  I
}

enum flightNature {
  CDB
  INSTRUCTION
}

enum instructionSubType {
  LOCAL
  NAVIGATION
  LACHE
  BAPTEME
  EXAM
}

model flight_logs {
  id        String  @id @default(uuid())
  clubID    String
  sessionID String?

  date              DateTime @db.Date
  planeID           String?
  planeRegistration String
  planeName         String
  planeClass        Int?

  pilotID        String
  pilotFirstName String
  pilotLastName  String
  pilotFunction  pilotFunction

  instructorID        String?
  instructorFirstName String?
  instructorLastName  String?
  studentID           String?
  studentFirstName    String?
  studentLastName     String?
  studentEmail        String?
  studentPhone        String?

  flightNature       flightNature
  instructionSubType instructionSubType?
  takeoffs           Int                 @default(1)
  landings           Int                 @default(1)

  departureAirfield String?
  arrivalAirfield   String?

  hobbsStart       Float?
  hobbsEnd         Float?
  fuelAdded        Float?
  machineAnomalies String?

  pilotSigned         Boolean   @default(false)
  pilotSignedAt       DateTime? @db.Timestamptz(6)
  personalObservation String?

  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  isManualEntry Boolean  @default(false)
}

// Demande de réservation d'un vol baptême passée depuis le lien public
// (/reservation/[clubID]/[token]), par un client externe sans compte.
// La demande PENDING pose un « hold » sur le créneau (expiresAt = TTL) jusqu'à
// validation/refus par le pilote assigné ou la gestion. Expiration paresseuse :
// une demande PENDING dont expiresAt < now est considérée expirée à la lecture.
model BaptemeRequest {
  id                String        @id @default(uuid())
  clubID            String
  sessionID         String // créneau flight_sessions visé
  firstName         String
  lastName          String
  email             String
  phone             String
  comment           String?
  planeID           String // machine club choisie
  // Formule choisie (durée + tarif), copiée depuis BaptemeOption au moment de la
  // demande : la formule doit survivre à une modification/suppression ultérieure
  // de la config de la machine (même logique que les champs dénormalisés de
  // flight_logs). null => la machine n'avait pas (ou plus) de formule configurée.
  optionDurationMin Int?
  optionPrice       Float?
  status            BaptemeStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  expiresAt         DateTime // TTL du hold
  handledBy         String? // userID du validateur / refuseur
  handledAt         DateTime?

  @@index([clubID, status])
  @@index([sessionID, status])
}

enum WalletTransactionType {
  CREDIT // paiement reçu (crédit manuel)
  DEBIT // débit automatique d'un vol d'instruction signé
  ADJUSTMENT // retrait / correction manuelle, ou correction auto d'un vol signé modifié
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CARD
  OTHER
}

enum WalletRateSource {
  PLANE // tarif écolage de la machine du club
  INSTRUCTOR // tarif instructeur du club (machine privée)
}

// Solde courant d'un membre DANS un club (AER-66). Volontairement hors de
// `User` : de nombreuses actions renvoient des lignes User complètes au client,
// le solde y fuiterait. Une ligne par (club, membre), créée à la première
// opération ; absence de ligne => solde 0.
model Wallet {
  id           String   @id @default(uuid())
  clubID       String
  userID       String
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([clubID, userID])
}

// Historique immuable des mouvements d'un portefeuille : jamais modifié ni
// supprimé, une erreur se corrige par une opération inverse. Les champs du vol
// sont dénormalisés (même logique que flight_logs) pour rester lisibles si la
// machine ou le tarif change ensuite.
model WalletTransaction {
  id                String                @id @default(uuid())
  clubID            String
  userID            String
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  type              WalletTransactionType
  amountCents       Int // signé : > 0 crédite, < 0 débite
  balanceAfterCents Int
  paymentMethod     PaymentMethod?
  comment           String?
  authorID          String? // null => opération automatique (signature / correction de vol)
  flightLogID       String?
  flightDate        DateTime?             @db.Date
  planeName         String?
  planeRegistration String?
  durationMin       Int?
  rateCents         Int?
  rateSource        WalletRateSource?

  @@index([clubID, userID, createdAt])
  @@index([flightLogID])
}
